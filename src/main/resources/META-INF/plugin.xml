<idea-plugin>
    <!-- Values with SET_BY_GRADLE are defined in patchPluginXml task in build.gradle. -->
    <name>Gitflow Navigator</name>
    <id>SET_BY_GRADLE</id>
    <description>SET_BY_GRADLE</description>
    <version>SET_BY_GRADLE</version>
    <category>VCS Integration</category>
    <vendor url="https://github.com/borisovcode">BorisovCode</vendor>

    <depends>com.intellij.modules.vcs</depends>
    <depends>com.intellij.tasks</depends>
    <depends>Git4Idea</depends>

    <idea-version since-build="SET_BY_GRADLE" until-build="SET_BY_GRADLE"/>

    <actions>
        <action id="GitflowNavigator.OpenGitflowPopup" class="gitflow.actions.OpenGitflowPopup"
                text="Gitflow Navigator Operations..." />

        <action id="GitflowNavigator.InitRepo" class="gitflow.actions.InitRepoAction"
                text="Initialize Gitflow Repository..."
                icon="AllIcons.Actions.Lightning"
        />

        <action id="GitflowNavigator.ReInitRepo" class="gitflow.actions.ReInitRepoAction"
                text="Re-initialize Gitflow Repository..." />

        <action id="GitflowNavigator.StartFeature" class="gitflow.actions.StartFeatureAction"
                text="Start Feature..."
                icon="AllIcons.Vcs.Branch"
        />
        <action id="GitflowNavigator.FinishFeature" class="gitflow.actions.FinishFeatureAction"
                text="Finish Feature"
                icon="AllIcons.Vcs.Merge"
        />
        <action id="GitflowNavigator.PublishFeature" class="gitflow.actions.PublishFeatureAction"
                text="Publish Feature"
                icon="AllIcons.Vcs.Push"
        />
        <action id="GitflowNavigator.TrackFeature" class="gitflow.actions.TrackFeatureAction"
                text="Track Feature..."
                icon="AllIcons.Actions.CheckOut"
        />

        <action id="GitflowNavigator.StartRelease" class="gitflow.actions.StartReleaseAction"
                text="Start Release..."
                icon="AllIcons.Vcs.Branch"
        />
        <action id="GitflowNavigator.FinishRelease" class="gitflow.actions.FinishReleaseAction"
                text="Finish Release"
                icon="AllIcons.Vcs.Merge"
        />
        <action id="GitflowNavigator.PublishRelease" class="gitflow.actions.PublishReleaseAction"
                text="Publish Release"
                icon="AllIcons.Vcs.Push"
        />
        <action id="GitflowNavigator.TrackRelease" class="gitflow.actions.TrackReleaseAction"
                text="Track Release..."
                icon="AllIcons.Actions.CheckOut"
        />

        <action id="GitflowNavigator.StartHotfix" class="gitflow.actions.StartHotfixAction"
                text="Start Hotfix..."
                icon="AllIcons.Vcs.Branch"
        />
        <action id="GitflowNavigator.FinishHotfix" class="gitflow.actions.FinishHotfixAction"
                text="Finish Hotfix"
                icon="AllIcons.Vcs.Merge"
        />

        <action id="GitflowNavigator.PublishHotfix" class="gitflow.actions.PublishHotfixAction"
                text="Publish Hotfix"
                icon="AllIcons.Vcs.Push"
        />

        <action id="GitflowNavigator.StartBugfix" class="gitflow.actions.StartBugfixAction"
                text="Start Bugfix..."
                icon="AllIcons.Vcs.Branch"
        />

        <action id="GitflowNavigator.FinishBugfix" class="gitflow.actions.FinishBugfixAction"
                text="Finish Bugfix"
                icon="AllIcons.Vcs.Merge"
        />

        <action id="GitflowNavigator.PublishBugfix" class="gitflow.actions.PublishBugfixAction"
                text="Publish Bugfix"
                icon="AllIcons.Vcs.Push"
        />

        <action id="GitflowNavigator.TrackBugfix" class="gitflow.actions.TrackBugfixAction"
                text="Track Bugfix..."
                icon="AllIcons.Actions.CheckOut"
        />

        <group id="GitflowNavigator.Menu" popup="true" text="Gitflow Navigator"
                class="gitflow.GitflowMenu">
            <add-to-group group-id="Git.MainMenu" />
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceInterface="gitflow.Gitflow" serviceImplementation="gitflow.GitflowImpl"/>
        <applicationService serviceInterface="gitflow.GitflowState" serviceImplementation="gitflow.GitflowState"></applicationService>
        <projectConfigurable instance="gitflow.GitflowConfigurable"/>
        <tasks.dialogPanelProvider implementation="gitflow.ui.GitflowTaskDialogPanelProvider"/>
        <statusBarWidgetFactory id="gitflowNavigatorWidget" implementation="gitflow.ui.GitflowStatusBarWidgetFactory" order="after inspectionProfileWidget"/>
        <notificationGroup id="Gitflow Navigator Errors" displayType="STICKY_BALLOON" toolWindowId="Version Control"/>
        <notificationGroup id="Gitflow Navigator Notifications" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
